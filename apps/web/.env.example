# apps/web reads the SAME Supabase project as Council of Days (apps/calendar).
# Vestige promotes the existing CoD production project to be the platform DB.
# Copy this to .env.local and fill in the real values from the Supabase dashboard
# (Settings → API). NEVER commit .env.local — it is gitignored.

# Existing CoD project URL (e.g. https://oyalinqyqwztwkqqtmgx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key (browser-safe, respects RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only service-role key — bypasses RLS. Never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Base URL used for magic-link redirects (local dev = http://localhost:3001)
NEXT_PUBLIC_SITE_URL=http://localhost:3001
